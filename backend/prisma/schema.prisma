generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Linea {
  id       Int       @id @default(autoincrement())
  nombre   String    @unique
  maquinas Maquina[]
}

model Maquina {
  id            Int              @id @default(autoincrement())
  nombre        String
  qrCode        String           @unique
  lineaId       Int
  linea         Linea            @relation(fields: [lineaId], references: [id])
  puntos        PuntoBloqueo[]
  eventos       EventoLOTO[]
  bloqueoActivo BloqueoMaquina?
  imagenes      ImagenMaquina[]
}

model PuntoBloqueo {
  id                  Int             @id @default(autoincrement())
  nombre              String
  tipoEnergia         TipoEnergia     @default(OTRA)
  identificador       String?
  ubicacion           String?
  metodoAccion        String?
  dispositivoBloqueo  String?
  validacion          String?
  orden               Int
  maquinaId           Int
  maquina             Maquina         @relation(fields: [maquinaId], references: [id])
  eventoPuntos        EventoPunto[]

  @@unique([maquinaId, orden])
}

model ImagenMaquina {
  id        Int     @id @default(autoincrement())
  maquinaId Int
  url       String
  etiqueta  String?
  orden     Int     @default(1)
  maquina   Maquina @relation(fields: [maquinaId], references: [id])
}

model PasoGenerico {
  id          Int                  @id @default(autoincrement())
  orden       Int                  @unique
  titulo      String
  descripcion String
  eventoPasos EventoPasoGenerico[]
}

model Operador {
  id             Int         @id @default(autoincrement())
  numeroEmpleado String      @unique
  eventos        EventoLOTO[]
}

model EventoLOTO {
  id                 Int                  @id @default(autoincrement())
  maquinaId          Int
  operadorId         Int
  estado             EstadoEvento         @default(ABIERTO)
  horaInicio         DateTime             @default(now())
  horaFin            DateTime?
  duracionMinutos    Int?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  maquina             Maquina              @relation(fields: [maquinaId], references: [id])
  operador            Operador             @relation(fields: [operadorId], references: [id])
  puntos              EventoPunto[]
  pasosGenericos      EventoPasoGenerico[]
  bloqueoActivo       BloqueoMaquina?
  integracionEnviada  Boolean              @default(false)
  integracionError    String?
  checkoutPasos       String               @default("[]")
  confirmacionBase    Boolean              @default(false)
}

model BloqueoMaquina {
  id        Int        @id @default(autoincrement())
  maquinaId Int        @unique
  eventoId  Int        @unique
  maquina   Maquina    @relation(fields: [maquinaId], references: [id])
  evento    EventoLOTO @relation(fields: [eventoId], references: [id])
  creadoAt  DateTime   @default(now())
}

model EventoPunto {
  id            Int          @id @default(autoincrement())
  eventoId      Int
  puntoBloqueoId Int
  tipo          TipoEventoPunto
  orden         Int
  completado    Boolean      @default(false)
  realizadoAt   DateTime?
  evento        EventoLOTO   @relation(fields: [eventoId], references: [id])
  puntoBloqueo  PuntoBloqueo @relation(fields: [puntoBloqueoId], references: [id])

  @@unique([eventoId, puntoBloqueoId, tipo])
}

model EventoPasoGenerico {
  id             Int             @id @default(autoincrement())
  eventoId       Int
  pasoGenericoId Int
  tipo           TipoEventoPunto
  completado     Boolean         @default(false)
  realizadoAt    DateTime?
  evento         EventoLOTO      @relation(fields: [eventoId], references: [id])
  pasoGenerico   PasoGenerico    @relation(fields: [pasoGenericoId], references: [id])

  @@unique([eventoId, pasoGenericoId, tipo])
}

enum EstadoEvento {
  ABIERTO
  CERRADO
}

enum TipoEventoPunto {
  CHECKIN
  CHECKOUT
}

enum TipoEnergia {
  ELECTRICA
  NEUMATICA
  HIDRAULICA
  GRAVEDAD
  MECANICA
  OTRA
}
